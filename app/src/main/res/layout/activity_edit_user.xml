<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:fillViewport="true"
    android:layout_width="match_parent"
    android:padding="20dp"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- FIRST NAME -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutFirstName"
            android:hint="First Name"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            app:boxBackgroundMode="outline"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtFirstName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MIDDLE NAME -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMiddleName"
            android:hint="Middle Name"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            app:boxBackgroundMode="outline"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMiddleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- LAST NAME -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutLastName"
            android:hint="Last Name"
            android:layout_marginTop="12dp"
            android:layout_width="match_parent"
            app:boxBackgroundMode="outline"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtLastName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- DOB Picker -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutDob"
            android:layout_marginTop="12dp"
            android:hint="Date of Birth"
            app:boxBackgroundMode="outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtDob"
                android:focusable="false"
                android:clickable="true"
                android:inputType="none"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- MOBILE -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutMobile"
            android:hint="Mobile Number"
            android:layout_marginTop="12dp"
            app:boxBackgroundMode="outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtMobile"
                android:inputType="phone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- EMAIL -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutEmail"
            android:hint="Email"
            android:layout_marginTop="12dp"
            app:boxBackgroundMode="outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtEmail"
                android:inputType="textEmailAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ADDRESS -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutAddress"
            android:hint="Address"
            android:layout_marginTop="12dp"
            app:boxBackgroundMode="outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/edtAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- ROLE DROPDOWN -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutRole"
            android:hint="User Role"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
            app:boxBackgroundMode="outline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <AutoCompleteTextView
                android:id="@+id/autoRole"
                android:inputType="none"
                android:clickable="true"
                android:focusable="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- STATUS DROPDOWN -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/layoutStatus"
            android:hint="Status"
            android:layout_marginTop="12dp"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <AutoCompleteTextView
                android:id="@+id/autoStatus"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>
        </com.google.android.material.textfield.TextInputLayout>

        <!-- UPDATE BUTTON -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUpdateUser"
            android:text="Update User"
            style="@style/Widget.Admin.PrimaryButton"
            android:layout_marginTop="24dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

    </LinearLayout>
</ScrollView>
