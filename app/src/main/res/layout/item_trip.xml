<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="10dp"
    android:padding="12dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Trip Header -->
        <TextView
            android:id="@+id/tvTripNumber"
            android:text="Trip #123"
            android:textStyle="bold"
            android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Vehicle & Driver -->
        <TextView
            android:id="@+id/tvVehicle"
            android:text="Vehicle: MH12AB1234"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <TextView
            android:id="@+id/tvDriver"
            android:text="Driver: John Doe"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Route -->
        <TextView
            android:id="@+id/tvRoute"
            android:text="Route: Pune → Mumbai"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Date -->
        <TextView
            android:id="@+id/tvDate"
            android:text="Date: 12 Nov 2025"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>

        <!-- Trip Status -->
        <TextView
            android:id="@+id/tvStatus"
            android:text="ONGOING"
            android:textStyle="bold"
            android:textColor="@color/md_theme_primary"
            android:layout_marginTop="6dp"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"/>


        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <Button
                android:id="@+id/btnView"
                android:text="View"
                style="@style/Widget.Admin.PrimaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnEdit"
                android:text="Edit"
                style="@style/Widget.Admin.PrimaryButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />


        </LinearLayout>

        <TextView
            android:id="@+id/btnGenerateBill"
            android:text="Generate Bill"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            style="@style/Widget.Admin.SecondaryButton"/>

        <TextView
            android:id="@+id/btnViewBill"
            android:text="View Bill"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            style="@style/Widget.Admin.SecondaryButton"/>

        <TextView
            android:id="@+id/btnEditBill"
            android:text="Edit Bill"
            android:layout_height="wrap_content"
            android:layout_width="match_parent"
            style="@style/Widget.Admin.SecondaryButton"/>


    </LinearLayout>



</com.google.android.material.card.MaterialCardView>
