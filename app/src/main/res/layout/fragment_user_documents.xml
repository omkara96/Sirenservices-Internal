<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- No Documents Label -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/lblEmptyDocs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="No documents uploaded"
            android:textAlignment="center"
            android:textSize="16sp"
            android:padding="20dp"
            android:visibility="gone"
            android:textColor="@android:color/darker_gray" />

        <!-- ========= DOCUMENT ITEM TEMPLATE ========= -->
        <!-- Each Card: Title + Image + Replace Button -->

        <!-- AADHAR FRONT -->
        <LinearLayout
            android:id="@+id/layoutAadharFront"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textview.MaterialTextView
                android:text="Aadhar (Front)"
                android:textStyle="bold"
                android:textSize="15sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="6dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAadharFront"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgAadharFront"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplaceAadharFront"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replace"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- AADHAR BACK -->
        <LinearLayout
            android:id="@+id/layoutAadharBack"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textview.MaterialTextView
                android:text="Aadhar (Back)"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAadharBack"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgAadharBack"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplaceAadharBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replace"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- PAN CARD -->
        <LinearLayout
            android:id="@+id/layoutPan"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textview.MaterialTextView
                android:text="PAN Card"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPan"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgPan"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplacePan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replace"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- PASSBOOK -->
        <LinearLayout
            android:id="@+id/layoutPassbook"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textview.MaterialTextView
                android:text="Bank Passbook"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPassbook"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgPassbook"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplacePassbook"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replace"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- LICENSE -->
        <LinearLayout
            android:id="@+id/layoutLicence"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <com.google.android.material.textview.MaterialTextView
                android:text="Driving Licence"
                android:textStyle="bold"
                android:textSize="15sp"
                android:paddingBottom="6dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLicence"
                style="@style/Widget.Material3.CardView.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:id="@+id/imgLicence"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:scaleType="centerCrop" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReplaceLicence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Replace"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
