<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:orientation="vertical"
        android:paddingBottom="28dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardMain"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="5dp">

            <LinearLayout
                android:padding="18dp"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvTripNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="TRIP-XXXX"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <TextView android:text="Date" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvTripDate" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView android:text="Vehicle" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvVehicle" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView android:text="Driver" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvDriver" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView android:text="Pickup" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvPickup" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView android:text="Final Drop" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvDrop" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView android:text="Intermediate Stops" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <LinearLayout
                    android:id="@+id/layoutStops"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView android:text="Trip Cost" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvTripCost" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView android:text="Fuel Cost" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvFuelCost" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView android:text="Servicing Cost" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvServicingCost" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView android:text="Pending Amount" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    />
                <TextView android:id="@+id/tvPendingAmount" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>

                <TextView android:text="Payment Mode" style="@style/viewLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
                <TextView android:id="@+id/tvPaymentMode" style="@style/viewValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Edit button (hidden for completed trips) -->
        <Button
            android:id="@+id/btnEditTrip"
            android:text="Edit Trip"
            style="@style/Widget.Admin.PrimaryButton"
            android:layout_marginTop="20dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </LinearLayout>
</ScrollView>
